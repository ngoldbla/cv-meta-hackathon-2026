   "encodingFormat": "application/octet-stream",
   "sha256": "880caecef08d2ebff9e277504c8ccef4bd28be434ccec9e420817d5f516910c0"
  },
  {
   "@type": "cr:FileObject",
   "@id": "train/specs.jsonl",
   "name": "train/specs.jsonl",
   "contentUrl": "train/specs.jsonl",
   "encodingFormat": "application/jsonlines",
   "sha256": "59de39e427148a12525ae45adea5d84c0cc7e3a16e216716c0c4ab1a36fc1c13"
  },
  {
   "@type": "cr:FileObject",
   "@id": "dev/shard-000.npz",
   "name": "dev/shard-000.npz",
   "contentUrl": "dev/shard-000.npz",
   "encodingFormat": "application/octet-stream",
   "sha256": "256e1d4f371f860f416fe70f7c330a97e7ae3b900e7b8a877909ad09fa0be16e"
  },
  {
   "@type": "cr:FileObject",
   "@id": "dev/specs.jsonl",
   "name": "dev/specs.jsonl",
   "contentUrl": "dev/specs.jsonl",
   "encodingFormat": "application/jsonlines",
   "sha256": "5e5502398f8de7d0ec464729f9bbf31cd0059b02a0d7935af43b3ab8eecdf4e9"
  }
 ],
 "recordSet": [
  {
   "@type": "cr:RecordSet",
   "name": "decisions",
   "field": [
    {
     "@type": "cr:Field",
     "name": "car",
     "description": "per-car observable features (n_cars x car_dim)"
    },
    {
     "@type": "cr:Field",
     "name": "floor",
     "description": "per-floor observable features (n_floors x 12)"
    },
    {
     "@type": "cr:Field",
     "name": "glob",
     "description": "global observable features (7)"
    },
    {
     "@type": "cr:Field",
     "name": "mask",
     "description": "valid candidate cars"
    },
    {
     "@type": "cr:Field",
     "name": "q_k",
     "description": "counterfactual tail-aware waiting cost per CRN rollout and candidate car (K x n_cars)"
    },
    {
     "@type": "cr:Field",
     "name": "q_mean",
     "description": "mean counterfactual cost per candidate car"
    },
    {
     "@type": "cr:Field",
     "name": "q_std",
     "description": "std of counterfactual cost across CRN rollouts"
    },
    {
     "@type": "cr:Field",
     "name": "best",
     "description": "index of the counterfactual-best car"
    },
    {
     "@type": "cr:Field",
     "name": "esa_choice",
     "description": "car chosen by the ESA planner baseline"
    },
    {
     "@type": "cr:Field",
     "name": "eta_choice",
     "description": "car chosen by the ETA baseline"
    },
    {
     "@type": "cr:Field",
     "name": "t",
     "description": "decision time (s)"
    },
    {
     "@type": "cr:Field",
     "name": "call",
     "description": "hall call (floor, direction)"
    },
    {
     "@type": "cr:Field",
     "name": "instance",
     "description": "instance id (see specs.jsonl)"
    }
   ]
  }
 ]
}