   "sha256": "c5f1f39ac85f3f9de2d205838ba49eabf4647fe1f584313c3ba2c73ac936bd9a"
  },
  {
   "@type": "cr:FileObject",
   "@id": "dev/specs.jsonl",
   "name": "dev/specs.jsonl",
   "contentUrl": "dev/specs.jsonl",
   "encodingFormat": "application/jsonlines",
   "sha256": "fad3322075db6abb468fe2dee615e447f8bbdc0877c860969420d21fcb70c4d5"
  }
 ],
 "recordSet": [
  {
   "@type": "cr:RecordSet",
   "name": "decisions",
   "field": [
    {
     "@type": "cr:Field",
     "name": "veh",
     "description": "per-slot observable features (8 slots x 14): no action, four nearest trains express, a yard train, two buses"
    },
    {
     "@type": "cr:Field",
     "name": "stn",
     "description": "per-station observable features (22 stations x 12)"
    },
    {
     "@type": "cr:Field",
     "name": "glob",
     "description": "global observable features (13)"
    },
    {
     "@type": "cr:Field",
     "name": "mask",
     "description": "valid candidate slots"
    },
    {
     "@type": "cr:Field",
     "name": "q_k",
     "description": "counterfactual tail-aware waiting cost per CRN rollout and slot (K x 8; NaN = invalid slot)"
    },
    {
     "@type": "cr:Field",
     "name": "q_mean",
     "description": "mean counterfactual cost per slot"
    },
    {
     "@type": "cr:Field",
     "name": "q_std",
     "description": "std of counterfactual cost across CRN rollouts"
    },
    {
     "@type": "cr:Field",
     "name": "best",
     "description": "index of the counterfactual-best slot"
    },
    {
     "@type": "cr:Field",
     "name": "planner_choice",
     "description": "slot chosen by the rolling-horizon dispatcher"
    },
    {
     "@type": "cr:Field",
     "name": "rule_choice",
     "description": "slot chosen by the express rule (current practice)"
    },
    {
     "@type": "cr:Field",
     "name": "t",
     "description": "decision time (s)"
    },
    {
     "@type": "cr:Field",
     "name": "call",
     "description": "alert (station, direction, level)"
    },
    {
     "@type": "cr:Field",
     "name": "instance",
     "description": "instance id (see specs.jsonl)"
    }
   ]
  }
 ]
}