# Low Key environment variables (task 044). Names only: never commit values.
# Set these in your Vercel project (Settings → Environment Variables) and,
# for local runs and the weekly pipeline, in ~/.config/low-key/env.

# --- Required: listings and sold-vehicle data (paid) -------------------------
# Low Key's data comes from Visor (https://visor.vin). Sign up for an API key
# there; read its API licence first (Low Key keeps no listing database).
LOWKEY_PROVIDER_KEY=
# The provider's REST base URL (from your Visor account).
LOWKEY_PROVIDER_BASE_URL=
# The provider's MCP URL, used by the weekly pipeline (optional for the app).
LOWKEY_PROVIDER_MCP_URL=

# --- Required: weekly gas prices ----------------------------------------------
# Free registration at https://www.eia.gov/opendata/ (pipeline only).
EIA_API_KEY=

# --- Required on Vercel: the weekly data table --------------------------------
# Created when you add a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
# Optional, local only: read the table from a file instead of Blob.
LOWKEY_TABLE_FILE=

# --- Optional: the photo reader (Check a quote) --------------------------------
# Your own Modal deployment of cloud/quote_reader (see lowkey/docs/roll-your-own.md).
# Without these, Check a quote still works as a typed form.
LOWKEY_QUOTE_URL=
# A long random token; the same value goes in the Modal secret `lowkey-quote-auth`
# as QUOTE_TOKEN. Keep it server-side only.
LOWKEY_QUOTE_TOKEN=

# No key needed: FRED (loan rate), the U.S. Census geocoder, fueleconomy.gov.
